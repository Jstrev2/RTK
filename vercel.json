{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.runnertoolkit.com"
        }
      ],
      "destination": "https://runnertoolkit.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.runnertoolkit.com"
        }
      ],
      "destination": "https://runnertoolkit.com/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(og\\.jpg|og\\.png|icon\\.svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 9 * * *"
    }
  ]
}
